    "rxjs": "^7.8.2",
    "storybook": "10.3.5",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.59.0",
    "verdaccio": "^6.3.2",
    "zone.js": "~0.15.1"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,scss,css,html,md}": [
